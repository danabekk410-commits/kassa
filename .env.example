# Общий ключ доступа: телефоны открывают кассу по ссылке https://<домен>/kassa/#k=<KASSA_KEY> (не короче 16 символов: A-Z a-z 0-9 _ -)
KASSA_KEY=
# Необязательно — путь к SQLite-базе (по умолчанию data/kassa.db)
# KASSA_DB=data/kassa.db
# Необязательно — порт API на 127.0.0.1 (по умолчанию 5054)
# KASSA_PORT=5054
